# Игнорируем все файлы и папки
*

# Исключаем папку server из игнорирования
!server/

# Исключаем папку static из игнорирования
!server/static/

# В папке static не игнорируем указанные форматы
!server/static/**/*.js
!server/static/**/*.css
!server/static/**/*.webp
!server/static/**/*.png
!server/static/**/*.jpeg
!server/static/**/*.jpg
!server/static/**/*.svg
!server/static/**/*.gif
!server/static/**/*.fig

# Следим только за .py, .md и .txt файлами в корне и подкаталогах
!*.py
!*.md
!*.txt
!**/*.py
!**/*.md
!**/*.txt
!**/*.html
